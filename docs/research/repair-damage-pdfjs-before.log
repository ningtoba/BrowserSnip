# step 4 — pdf.js, the engine this app renders with, over both sides. `P` marks a
# sheet whose display list holds a painting operator, `W` one whose extracted text
# holds a planted word, so `.-` is a sheet that counts and prints nothing.
# With `src/lib/pdf-engine/{commands,tools/optimize}.ts` reverted at the same commit
# as the after pair, on the same corpus bytes: three cases produce no file at all,
# one refuses while quoting the engine's own TypeError, and `ledger-32-input` — the
# input docs/TOOL-TRIAGE.md §2 was measured with — returns 1 sheet at 0.0 % ink.

case                     pdf.js reads the input    pdf.js reads the repaired file
base-objstm              4p [PW PW PW PW]           4p [PW PW PW PW]
base-plain               4p [PW PW PW PW]           4p [PW PW PW PW]
base                     4p [PW PW PW PW]           4p [PW PW PW PW]
duplicate-endobj         4p [PW PW PW PW]           4p [PW PW PW PW]
garbage-dict-midstream   4p [PW PW PW PW]           4p [PW PW PW PW]
ledger-32-input          refused (Invalid PDF structure.) 4p [P- P- .- P-]
lying-xref               4p [PW PW PW PW]           4p [PW PW PW PW]
missing-endobj           4p [PW PW PW PW]           4p [PW PW PW PW]
missing-startxref        4p [PW PW PW PW]           4p [PW PW PW PW]
objstm-wrong-offsets     refused (Invalid Root reference.) 4p [PW PW PW PW]
plain-content-tailcut    refused (Invalid PDF structure.) 4p [PW PW PW PW]
triage-report            refused (Invalid PDF structure.) 4p [PW PW PW PW]
truncated-tail           refused (Invalid PDF structure.) 2p [PW .-]
